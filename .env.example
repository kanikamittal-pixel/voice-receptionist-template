# --- App ---
APP_URL=https://your-app.vercel.app
APP_SECRET=change-me-long-random          # signs transcript links
ADMIN_TOKEN=change-me                     # /admin and /api/admin/*
NIKHIL_TOKEN=change-me                    # /nikhil?t=<this>: Nikhil's HubSpot-backed dashboard
CRON_SECRET=change-me                     # Vercel Cron sends this as a Bearer token

# --- Neon ---
DATABASE_URL=postgres://...

# --- Vaani Labs (schema TBC: see lib/vaani.ts) ---
VAANI_WEBHOOK_KEY=change-me               # secret appended as ?key= to the webhook URL registered in Vaani
VAANI_AGENT_ID=                           # printed by `npm run agent:create`
VAANI_API_KEY=
VAANI_RATE_INR_PER_MIN=2.4                # VERIFY against your Vaani contract

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash             # VERIFY current Flash model id
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash   # tried in order if the primary is overloaded / out of quota

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=

# --- Cal.com (bookings made during the call; webhook tells the app) ---
CAL_API_KEY=                              # your Cal.com API key (also used to cancel a meeting when a designer passes)
CAL_WEBHOOK_SECRET=change-me              # signing secret for POST /api/webhooks/calcom
CAL_BOOKING_LINK=                         # optional default booking link; each designer can have their own

# --- HubSpot ---
HUBSPOT_TOKEN=                            # private app token

# --- Test script only (never point these at production data) ---
TEST_TELEGRAM_CHAT_ID=
TEST_CAL_EVENT_TYPE_ID=
TEST_ATTENDEE_EMAIL=                      # a real address you own: Cal.com rejects fake domains
